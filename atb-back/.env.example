# atb-back 환경설정 템플릿. 복사해서 .env 로 만든다:  cp .env.example .env
#
# 이 서버는 조회 전용이라 공공API 키가 필요 없다.
# 수집용 키(DATA_AUTH_KEY, NAVER_*)는 atb-program/.env 에 둔다.

PORT="4030"

MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="atb_db"

# 어드민: npx ts-node scripts/hash-password.ts <비밀번호> 로 만든 값을 넣는다
ADMIN_PASSWORD_HASH=""
# 세션 서명용 임의 문자열. 바꾸면 모든 관리자 세션이 끊긴다
ADMIN_SESSION_SECRET=""
