# atb-front 환경설정 템플릿. 복사해서 .env.local 로 만든다.

# 서버 컴포넌트가 백엔드를 직접 부를 때 쓰는 주소.
# 브라우저는 next.config.ts 의 rewrites 를 타지만 서버 렌더링은 절대 URL 이 필요하다.
API_BASE_URL="http://localhost:4030"

# canonical·og:url·sitemap 의 기준이 되는 사이트 주소. 배포 시 실제 도메인으로.
SITE_URL="http://localhost:4000"

# 네이버 클라우드 Maps > Application 의 Client ID (Dynamic Map). 브라우저에 노출되는 값이며
# 콘솔에 등록한 Web 서비스 URL 에서만 동작한다. Client Secret 은 필요 없다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=""

# 검색엔진 소유확인 코드 (등록 후 받는 값. 없으면 메타태그가 붙지 않는다)
# 구글 서치콘솔: HTML 태그 방식의 content 값
GOOGLE_SITE_VERIFICATION=""
# 네이버 서치어드바이저: 사이트 소유확인 content 값
NAVER_SITE_VERIFICATION=""
